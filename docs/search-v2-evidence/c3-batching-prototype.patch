+# ---------------------------------------------------------------------------
+# The provider, with the multi-source contract
+# ---------------------------------------------------------------------------
+class BatchClient(c2.KeyedClient):
+    """KeyedClient, plus runs of several URLs as the LinkedIn actor makes them.
+
+    A multi-URL start is matched to its searches' own Scripts through each
+    search's single-URL input. Its dataset is their items, each stamped with
+    the URL it came from (`inputUrl`), cut to `limitPerSource` per URL and
+    then to `count` overall, in `dataset_order`: "plan" (search after search),
+    "reverse" (the LAST search's rows first) or "interleave". A Script's
+    `source` overrides its items' inputUrl: None removes it, a string replaces
+    it. The batch run lasts as long as its slowest search, bills their sum."""
+
+    dataset_order = "plan"
+
+    def _start(self, actor_id, run_input, ceiling):
+        urls = run_input.get("urls") or []
+        if len(urls) <= 1:
+            return super()._start(actor_id, run_input, ceiling)
+        members = [self.by_input[c2.input_key(actor_id, dict(
+            run_input, urls=[u], count=run_input["limitPerSource"]))] for u in urls]
+        self._log("start", actor_id, copy.deepcopy(run_input), ceiling)
+        scripts = [s for _, s in members]
+        _sleep(max(s.delay.get("start", 0) for s in scripts))
+        failing = [s.start_error for s in scripts if s.start_error]
+        if failing:
+            raise failing[0]
+        per = []
+        for script, url in zip(scripts, urls):
+            items = []
+            for item in copy.deepcopy(script.items[:run_input["limitPerSource"]]):
+                source = getattr(script, "source", url)
+                if source is None:
+                    item.pop("inputUrl", None)
+                else:
+                    item["inputUrl"] = source
+                items.append(item)
+            per.append(items)
+        if self.dataset_order == "reverse":
+            per = per[::-1]
+        items = ([i for group in itertools_zip_longest(per) for i in group]
+                 if self.dataset_order == "interleave" else [i for group in per for i in group])
+        combined = Script(
+            items[:run_input["count"]],
+            status=next((s.status for s in scripts if s.status != "SUCCEEDED"),
+                        "SUCCEEDED"),
+            usage=round(sum(s.usage for s in scripts), 6),
+            polls=max(s.polls for s in scripts),
+            run_time=max(s.run_time for s in scripts),
+            delay={k: max(s.delay.get(k, 0) for s in scripts) for k in ("get", "dataset")})
+        combined.crash_on_poll = any(getattr(s, "crash_on_poll", False) for s in scripts)
+        run_id = f"run_{members[0][0] + 1}"
+        with self._lock:
+            self.runs[run_id] = [combined, 0, actor_id, True]
+            for key in (actor_id, "*"):
+                self.live[key] += 1
+                self.peak[key] = max(self.peak[key], self.live[key])
+        return SimpleNamespace(
+            id=run_id, build_id=f"build_{run_id}", started_at="2026-09-24T00:00:00Z",
+            options=SimpleNamespace(max_total_charge_usd=(
+                None if ceiling is None else float(ceiling))))
+
+    def _get(self, run_id):
+        if getattr(self.runs[run_id][0], "crash_on_poll", False):
+            raise c2.Crash("after the batched start, before its result")
+        return super()._get(run_id)
+
+
+def itertools_zip_longest(groups):
+    from itertools import zip_longest
+    return ([x for x in row if x is not None] for row in zip_longest(*groups))
+
+
+def c3_sweep(scripts, *, batch=2, workers=2, order="plan", env=None, **kw):
+    """c2_sweep with SWEEP_PAID_COMPACTION at `batch` searches per start (None:
+    the variables unset, i.e. V2-C2) against BatchClient."""
+    env = dict(env or {})
+    if batch is not None:
+        env.update({scraper.PAID_COMPACTION_FLAG: "1", LI_SIZE: str(batch)})
+    client = type("Client", (BatchClient,), {"dataset_order": order})
+    with mock.patch.object(c2, "KeyedClient", client):
+        return c2.c2_sweep(scripts, workers=workers, env=env, **kw)
+
+
+def urls_started(got):
+    """Per start, the keyword indexes of its URLs, in the order sent."""
+    out = []
+    for call in got.client.kinds("start"):
+        out.append([next(i for i, k in enumerate(KW) if k.split()[0] + "+" in u)
+                    for u in call[2]["urls"]])
+    return out
+
+
+def compaction(got):
+    return got.execution["compaction"]
+
+
+def by_unit(got):
+    return {u["unit_id"]: u for u in got.telemetry["units"] if u["path"] == "paid"}
+
+
+def labels(got):
+    return [r["search_query"] for r in got.rows] if got.csv else []
+
+
+def untimed(value):
+    """A record less its clocks, as C2's serial-parity test compares them."""
+    if isinstance(value, dict):
+        return {k: untimed(v) for k, v in value.items()
+                if not re.search(r"(_ms|_at)$", k)}
+    if isinstance(value, list):
+        return [untimed(v) for v in value]
+    return value
