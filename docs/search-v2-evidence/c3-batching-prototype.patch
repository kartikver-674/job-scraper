+# ===========================================================================
+# Checkpoints, crashes, resume — per LOGICAL search
+# ===========================================================================
+class Checkpoints(unittest.TestCase):
+    """Two searches in one start. The transaction stays per search — rows →
+    checkpoint → done marker — so a crash anywhere leaves no search marked
+    done without its rows, and a rerun buys only what is not done."""
+
+    def crash(self, patches, scripts=None, out=None):
+        out = out or tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, out, True)
+        got = c3_sweep(scripts or [Script(solo(u)) for u in range(2)], batch=2,
+                       workers=2, keywords=KW[:2], out=out, account=[1.0, 1.06],
+                       patches=patches)
+        self.assertIsInstance(got.error, c2.Crash)
+        c2.Checkpoints.assertDurable(self, got)
+        return got, out
+
+    def write_crash(self, n, torn=False):
+        real, calls = scraper.write_outputs, []
+
+        def write(out_rows, csv_path, json_path):
+            calls.append(1)
+            if len(calls) == n:
+                if not torn:
+                    raise c2.Crash("before this checkpoint")
+
+                def tear(src, dst):
+                    raise c2.Crash("halfway through the checkpoint")
+                with mock.patch.object(scraper.os, "replace", tear):
+                    return real(out_rows, csv_path, json_path)
+            return real(out_rows, csv_path, json_path)
+        return [mock.patch.object(scraper, "write_outputs", write)]
+
+    def test_1_crash_before_the_batched_start(self):
+        def boom(*a, **kw):
+            raise c2.Crash("before the start")
+        got, _ = self.crash([mock.patch.object(scraper, "_run_to_terminal", boom)])
+        self.assertEqual(got.client.kinds("start"), [])
+        self.assertEqual(got.done, [])
+
+    def test_2_crash_after_the_start_before_the_result(self):
+        scripts = [Script(solo(0)), Script(solo(1))]
+        scripts[1].crash_on_poll = True
+        got, _ = self.crash([], scripts=scripts)
+        self.assertEqual(len(got.client.kinds("start")), 1)
+        self.assertEqual(got.done, [])
+        self.assertIsNone(got.csv)
+
+    def test_3_crash_after_the_result_before_any_search_is_integrated(self):
+        real, reads = scraper.account_usage_usd, []
+
+        def read(client):
+            reads.append(1)
+            if len(reads) == 2:             # the first is the sweep's baseline
+                raise c2.Crash("reading the account for the batch's first search")
+            return real(client)
+        got, _ = self.crash([mock.patch.object(scraper, "account_usage_usd", read)])
+        self.assertEqual(len(got.client.kinds("dataset")), 1)       # the result was in
+        self.assertEqual(got.done, [])
+        self.assertIsNone(got.csv)
+
+    def test_4_crash_after_the_first_searchs_marker(self):
+        """Mutation H's test: marked done only after its own checkpoint."""
+        got, _ = self.crash(self.write_crash(2))
+        self.assertEqual(got.done, [f"{TODAY}|linkedin|{KW[0]}|Bengaluru|"])
+        self.assertEqual(set(labels(got)), {label(0)})
+
+    def test_5_crash_while_the_second_checkpoint_writes(self):
+        got, _ = self.crash(self.write_crash(2, torn=True))
+        self.assertEqual(got.done, [f"{TODAY}|linkedin|{KW[0]}|Bengaluru|"])
+        self.assertEqual(set(labels(got)), {label(0)})              # the previous one, whole
+
+    def test_6_9_10_resume_buys_only_the_undone_search(self):
+        got, out = self.crash(self.write_crash(2))
+        for path in Path(out).glob("jobs_*"):
+            os.replace(path, str(path).replace("jobs_", "jobs_run1_"))
+        again = c3_sweep([Script(solo(u)) for u in range(2)], batch=2, keywords=KW[:2],
+                         out=out, account=[2.0, 2.03])
+        self.assertIsNone(again.error)
+        self.assertEqual(urls_started(again), [[1]])                # never paid_000 again
+        self.assertEqual(again.status(), ["skipped_done", "completed"])
+        self.assertEqual(sorted(again.done), sorted(
+            f"{TODAY}|linkedin|{KW[u]}|Bengaluru|" for u in range(2)))
+
+    def test_8_no_done_search_ever_lacks_its_rows(self):
+        for n in (1, 2, 3):
+            for torn in (False, True):
+                with self.subTest(write=n, torn=torn):
+                    out = tempfile.mkdtemp()
+                    self.addCleanup(shutil.rmtree, out, True)
+                    got = c3_sweep([Script(solo(u)) for u in range(4)], batch=2,
+                                   workers=2, keywords=KW[:4], out=out,
+                                   account=[1.0, 1.06, 1.12],
+                                   patches=self.write_crash(n, torn))
+                    self.assertIsInstance(got.error, c2.Crash)
+                    c2.Checkpoints.assertDurable(self, got)
+                    self.assertEqual(len(got.done), n - 1)
+
